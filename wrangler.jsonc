{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campfiresongs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*", "!/fonts/*"]
  },
  // No database_id on purpose: the first `wrangler deploy` creates the D1
  // database for you and remembers it. The site creates its own tables on
  // first request (see lib/migrate.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campfiresongs",
      "migrations_dir": "migrations"
    }
  ],
  // Emails: once Email Sending is turned on for your domain in Cloudflare,
  // uncomment this line and redeploy. Until then emails are skipped.
  // "send_email": [{ "name": "EMAIL" }],
  // Daily tidy-up at 17:13 UTC (about 3-4am in eastern Australia).
  "triggers": { "crons": ["13 17 * * *"] },
  "vars": {
    "ADMIN_EMAIL": "hello@campfiresongs.org",
    // Cloudflare's always-passes test key. Replace with your real site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "observability": { "enabled": true }
}
